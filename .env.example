# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA faça commit de .env.local ou de qualquer arquivo com segredos reais.

# Painel do Supabase > Project Settings > API
# URL do projeto Supabase (pública, pode ser exposta ao browser)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável/anon do Supabase (pública, protegida por Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
