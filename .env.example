# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA faça commit de .env.local ou de qualquer arquivo com segredos reais.

# Painel do Supabase > Project Settings > API
# URL do projeto Supabase (pública, pode ser exposta ao browser)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável/anon do Supabase (pública, protegida por Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# Provedor de IA — SEGREDO DE SERVIDOR
#
# NÃO leva o prefixo NEXT_PUBLIC_, e isso é a proteção principal: só as
# variáveis com esse prefixo atravessam para o bundle do navegador. Uma
# chave com NEXT_PUBLIC_ seria publicada para todo visitante.
#
# Onde definir:
#   - desenvolvimento: .env.local (o .gitignore já ignora)
#   - produção: painel da Vercel > Settings > Environment Variables,
#     marcada para os ambientes desejados
#
# Nunca colar o valor em código, em commit, em issue ou em conversa.
# ---------------------------------------------------------------
OPENAI_API_KEY=
